# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Local-only credentials for Docker services. Never put real cloud credentials here.

# --- S3-compatible storage (MinIO), used from step 3 ---
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
