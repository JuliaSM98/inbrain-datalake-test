# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Local-only credentials for Docker services. Never put real cloud credentials here.

# --- S3-compatible storage (RustFS), used from step 3 ---
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme-at-least-8-chars
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- How Python code reaches the storage and where tables are written ---
# In real AWS: no S3_ENDPOINT (the SDK uses AWS's), credentials from an IAM role, not from here.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Default location for NEW Iceberg tables. Use file://... (or leave empty) for the local folder.
LAKEHOUSE_WAREHOUSE=s3://lakehouse/

# --- Airflow (step 7) ---
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=changeme          # to log into http://localhost:8080
AIRFLOW_JWT_SECRET=changeme-long-random  # signs the tokens between Airflow components
AIRFLOW_FERNET_KEY=                      # optional locally: encrypts stored connections/variables
